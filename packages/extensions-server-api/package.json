{
	"name": "@cairncms/extensions-server-api",
	"version": "1.5.0",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "tsc --project tsconfig.prod.json",
		"dev": "tsc --watch",
		"test": "vitest --watch=false"
	},
	"description": "Portable public API for CairnCMS server extensions",
	"repository": {
		"type": "git",
		"url": "https://github.com/CairnCMS/cairncms.git",
		"directory": "packages/extensions-server-api"
	},
	"license": "MIT",
	"author": "The CairnCMS Authors",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "22.19.17",
		"typescript": "5.0.4",
		"vitest": "3.2.6"
	}
}
