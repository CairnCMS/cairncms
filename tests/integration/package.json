{
	"name": "tests-integration",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "node run.mjs",
		"prepare:api": "node prepare.mjs",
		"test:harness": "node --test harness/*.test.mjs",
		"typecheck": "tsc --noEmit",
		"test:lifecycle": "node --test --test-concurrency=1 harness/lifecycle.check.mjs harness/wrapper.check.mjs harness/fixture-lifecycle.check.mjs",
		"test:services": "node --test --test-concurrency=1 harness/service-lifecycle.check.mjs harness/container-startup.check.mjs harness/database-cleanup.check.mjs harness/service-startup.check.mjs harness/service-fixtures.check.mjs",
		"test:restoration": "node --test --test-concurrency=1 harness/pristine.check.mjs"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.317.0",
		"@cairncms/sdk": "workspace:*",
		"@cairncms/test-utils": "workspace:*",
		"@cairncms/types": "workspace:*",
		"@types/js-yaml": "4.0.5",
		"@types/lodash": "4.14.194",
		"@types/node": "22.19.17",
		"@types/seedrandom": "3.0.5",
		"@types/supertest": "2.0.12",
		"@types/ws": "8.18.1",
		"@vitest/runner": "4.1.11",
		"autocannon": "7.10.0",
		"graphql-ws": "5.16.0",
		"ioredis": "5.3.2",
		"js-yaml": "4.3.2",
		"json-to-graphql-query": "2.2.5",
		"knex": "2.4.2",
		"lodash": "4.18.1",
		"mysql2": "3.24.5",
		"pg": "8.10.0",
		"seedrandom": "3.0.5",
		"sqlite3": "5.1.6",
		"supertest": "6.3.3",
		"testcontainers": "11.14.0",
		"typescript": "5.0.4",
		"uuid": "11.1.1",
		"vitest": "4.1.11",
		"ws": "8.21.0"
	}
}
