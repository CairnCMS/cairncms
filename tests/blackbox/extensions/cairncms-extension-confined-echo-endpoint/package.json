{
	"name": "cairncms-extension-confined-echo-endpoint",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"cairncms:extension": {
		"type": "endpoint",
		"path": "index.js",
		"source": "src/index.js",
		"runtime": "confined-server",
		"capabilities": {
			"endpoint": {
				"access": "public"
			},
			"items": "current-user"
		},
		"settings": {
			"site_label": { "type": "string", "scope": "global" },
			"api_key": { "type": "string", "scope": "global", "secret": { "source": "inline" } },
			"billing_key": { "type": "string", "scope": "global", "secret": { "source": "config" } }
		},
		"host": "^1.0.0"
	}
}
